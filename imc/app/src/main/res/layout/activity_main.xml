<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="267dp"
        android:contentDescription="imagem app imc"
        app:srcCompat="@drawable/imc" />

    <TextView
        android:id="@+id/labelPeso"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_margin="5pt"
        android:contentDescription="Peso"
        android:text="Peso:"
        android:textColor="#2196f3"
        android:textColorLink="#3F51B5"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/txtPeso"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="4pt"
        android:backgroundTint="#2196F3"
        android:ems="10"
        android:hint="Digite aqui seu peso"
        android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/labelAltura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4pt"
        android:contentDescription="Altura"
        android:text="Altura:"
        android:textColor="#2196F3"
        android:textColorLink="#3F51B5"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/txtAltura"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="4pt"
        android:ems="10"
        android:hint="Digite aqui sua altura"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30pt"
        android:layout_marginTop="10pt"
        android:layout_marginRight="30pt"
        android:layout_marginBottom="10pt"
        android:backgroundTint="#2388D7"
        android:text="Calcular IMC"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30pt"
        android:layout_marginTop="10pt"
        android:layout_marginRight="30pt"
        android:layout_marginBottom="10pt"
        android:backgroundTint="#2388D7"
        android:text="Limpar"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Resultado"
        android:text="Resultado"
        android:textAlignment="center"
        android:textColor="#2196f3"
        android:textColorLink="#3F51B5"
        android:textSize="20sp" />

</LinearLayout>