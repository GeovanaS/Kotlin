<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/labelPrimeiro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10pt"
        android:contentDescription="Primeiro Número"
        android:text="Digite aqui o primeiro número"
        android:textColor="#8F1CED"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/numero1"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="5pt"
        android:backgroundTint="#D459E9"
        android:ems="10"
        android:hint="Digite aqui seu segundo numero"
        android:inputType="number"
        android:textColor="#BF32D7" />

    <TextView
        android:id="@+id/labelSegundo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10pt"
        android:text="Digite aqui o segundo número"
        android:textColor="#8F1CED"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/numero2"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="5pt"
        android:backgroundTint="#D459E9"
        android:ems="10"
        android:hint="Digite aqui seu segundo número"
        android:inputType="number" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSomar"
            android:layout_width="164dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60pt"
            android:layout_marginRight="60pt"
            android:backgroundTint="#8F1CED"
            android:text="Somar" />

        <Button
            android:id="@+id/btnSubstrair"
            android:layout_width="164dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60pt"
            android:layout_marginRight="60pt"
            android:backgroundTint="#8F1CED"
            android:text="Substrair" />

        <Button
            android:id="@+id/btnMultiplicar"
            android:layout_width="164dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60pt"
            android:layout_marginRight="60pt"
            android:backgroundTint="#8F1CED"
            android:text="Multiplicação" />

        <Button
            android:id="@+id/btnDivisao"
            android:layout_width="164dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60pt"
            android:layout_marginRight="60pt"
            android:backgroundTint="#8F1CED"
            android:text="Divisao" />

        <TextView
            android:id="@+id/labelResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10pt"
            android:text="Resultado"
            android:textAlignment="center"
            android:textColor="#3048CA"
            android:textSize="20sp" />

    </LinearLayout>

</LinearLayout>